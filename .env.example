# Copy this file to .env locally. NEVER commit .env
BOT_TOKEN=replace_with_botfather_token
MINI_APP_URL=https://your-https-domain.example
ADMIN_TELEGRAM_ID=your_numeric_telegram_id
DATABASE_PATH=./maydon.db
CORS_ORIGINS=http://localhost:5173
# For miniapp create miniapp/.env.local with:
# VITE_API_URL=https://your-api-domain.example
# VITE_YANDEX_MAPS_KEY=your_yandex_js_maps_key
# NOTE: VITE_ variables are public in browser builds. Restrict Yandex key by domain.
